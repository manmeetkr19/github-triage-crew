# Copy this file to .env and fill in your own values. Never commit .env itself.

# GitHub personal access token. Used to call GitHub's hosted MCP server
# (https://api.githubcopilot.com/mcp/) as Authorization: Bearer <token>.
# Classic PAT with "repo" scope is simplest for a sandbox repo you own.
GITHUB_TOKEN=

# OpenRouter API key (https://openrouter.ai/keys). Used for all agent LLM calls
# via the OpenAI-compatible chat completions endpoint.
OPENROUTER_API_KEY=

# Which OpenRouter model to use. Picked together in Phase 0 once we check
# OpenRouter's current free/cheap tool-calling model list.
OPENROUTER_MODEL=

# The sandbox repo the crew operates on, as "owner/repo".
GITHUB_REPO=
